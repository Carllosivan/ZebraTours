# ========================================================
# Zebra Tours Moçambique - Segurança de Uploads Multimédia
# Prevenção contra execução remota de scripts (RCE)
# ========================================================

# 1. Desativar motor PHP se mod_php estiver presente
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# 2. Bloquear totalmente a execução de scripts e ficheiros executáveis
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|phar|sh|bash|pl|cgi|py|exe|bat|cmd)$">
    Order Deny,Allow
    Deny from all
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# 3. Desativar indexação de diretório e execução de CGI
Options -Indexes -ExecCGI

# 4. Proteger contra ataques de MIME-Sniffing no navegador
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
