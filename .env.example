# Port for Express and Vite dev server (AI Studio requires 3000)
PORT=3000

# Node environment (development | production)
NODE_ENV=development

# Application Public URL
APP_URL=http://localhost:3000

# Disable HMR (used in AI Studio preview)
DISABLE_HMR=false

# Google Gemini API Key (server-side operations)
GEMINI_API_KEY=
